generator client {
  provider = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  enrollments    Enrollment[]
  examAttempts   ExamAttempt[]
  createdExams   Exam[]           @relation("ExamCreator")
  createdCourses Course[]         @relation("CourseCreator")
}

model Course {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  createdBy   Int
  createdAt   DateTime @default(now())

  creator     User         @relation("CourseCreator", fields: [createdBy], references: [id])
  enrollments Enrollment[]
  exams       Exam[]
  videos      Video[]
}

model Enrollment {
  id              Int      @id @default(autoincrement())
  userId          Int
  courseId        Int
  receiptUrl      String   @db.Text
  receiptPublicId String   @db.Text
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  duration  Int      @default(0)
  passMark  Int      @default(0)
  courseId   Int
  createdBy Int
  isAdminApproved Boolean @default(true)
  createdAt DateTime @default(now())

  course    Course    @relation(fields: [courseId], references: [id])
  creator   User      @relation("ExamCreator", fields: [createdBy], references: [id])
  questions Question[]
  attempts  ExamAttempt[]
}

model Question {
  id            Int    @id @default(autoincrement())
  examId        Int
  questionText  String @db.Text
  correctAnswer String @db.Text
  marks         Int

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers Answer[]
}

model ExamAttempt {
  id        Int      @id @default(autoincrement())
  examId    Int
  studentId Int
  score     Int?
  createdAt DateTime @default(now())
  isGraded  Boolean  @default(false)

  exam    Exam    @relation(fields: [examId], references: [id])
  student User    @relation(fields: [studentId], references: [id])
  answers Answer[]

  @@unique([examId, studentId])
}

model Answer {
  id            Int    @id @default(autoincrement())
  attemptId     Int
  questionId    Int
  studentAnswer String @db.Text
  similarity    Float?
  marksAwarded  Int?
  feedback      String? @db.Text

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])
}

model Video {
  id        Int      @id @default(autoincrement())
  courseId   Int
  title     String
  videoUrl  String   @db.Text
  publicId  String   @db.Text
  isAdminApproved Boolean @default(true)
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}